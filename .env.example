# GharDekho Environment Configuration Template
# Copy to .env for custom deployments

# Server Configuration
PORT=4000
NODE_ENV=development

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
MAX_REQUESTS_PER_WINDOW=20

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=*

# Optional Third-Party Integrations (Future Phases)
# GOOGLE_MAPS_API_KEY=your_google_maps_key_here
# FIREBASE_PROJECT_ID=ghardekho-live
# MSG91_AUTH_KEY=your_sms_gateway_key_here
